{
  "name": "@flowscripter/plugin-api",
  "version": "2.0.1",
  "description": "Flowscripter plugin API: interfaces for command and component plugins",
  "keywords": [
    "api",
    "bun",
    "flowscripter",
    "plugin"
  ],
  "homepage": "https://github.com/flowscripter/plugin-api#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowscripter/plugin-api.git"
  },
  "files": [
    "dist",
    "src",
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@flowscripter/dynamic-cli-framework-api": "^5.1.3",
    "@flowscripter/dynamic-plugin-framework": "^2.3.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "typedocOptions": {
    "readme": "none",
    "exclude": [
      "tests/**"
    ]
  }
}
